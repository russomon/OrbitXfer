{
  "name": "orbitxfer-iroh-tauri",
  "private": true,
  "version": "0.1.58",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sync:cli": "node ./scripts/sync-cli.js",
    "build:cli:release": "cd ../OrbitXfer-iroh-cli && cargo build --release",
    "build:cli:debug": "cd ../OrbitXfer-iroh-cli && cargo build",
    "prepare:bundle": "npm run build:cli:release && npm run sync:cli && npm run build",
    "build:mac:signed": "bash ./scripts/build-mac-signed.sh",
    "verify:mac:release": "bash ./scripts/verify-macos-release.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
