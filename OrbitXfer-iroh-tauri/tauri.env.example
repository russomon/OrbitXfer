# Copy this file to tauri.env for a local signed + notarized macOS build.
# Real credentials must NOT be committed — tauri.env is gitignored.
#
# Use scripts/build-mac-signed.sh to source this file and run the build:
#   ./scripts/build-mac-signed.sh
#
# Or source manually:
#   set -a && source tauri.env && set +a && npm run tauri build

# Developer ID Application identity (must already be installed in your
# login keychain). Quotes are REQUIRED because the identity contains
# parentheses and a colon — bash chokes on them otherwise.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Recommended notarization flow: App Store Connect API key.
# Tauri's bundler env var naming differs from electron-builder's:
#   APPLE_API_KEY      = 10-char Key ID (NOT a file path)
#   APPLE_API_KEY_PATH = absolute path to the .p8 file
#   APPLE_API_ISSUER   = team's Issuer ID (UUID)
APPLE_API_KEY="ABC123DEFG"
APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_ABC123DEFG.p8"
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"

# Alternative: use a notarytool keychain profile already configured via
#   xcrun notarytool store-credentials orbitxfer-notary --apple-id ... --team-id ... --password ...
# Set this and Tauri will pass --keychain-profile to notarytool instead.
# APPLE_KEYCHAIN_PROFILE=orbitxfer-notary
